# ── Login ─────────────────────────────────────────────
ADMIN_PASSWORD=choose-a-strong-password
# Random string used to sign the login cookie (openssl rand -hex 32)
SESSION_SECRET=

# ── Database (Supabase) ───────────────────────────────
# Leave blank to use a local JSON file (demo only, not for deployment).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Email (Resend) ────────────────────────────────────
# Leave RESEND_API_KEY blank (or set EMAIL_MODE=mock) to log instead of send.
RESEND_API_KEY=
# Must be an address on a domain verified in Resend.
EMAIL_FROM="Accounts <accounts@yourdomain.com>"
EMAIL_REPLY_TO=
# Signing secret from Resend → Webhooks (for bounce tracking)
RESEND_WEBHOOK_SECRET=
# EMAIL_MODE=mock

# ── Scheduler ─────────────────────────────────────────
# Vercel sends this automatically to cron routes when set.
CRON_SECRET=

# ── Business settings ─────────────────────────────────
BUSINESS_NAME="Your Business Name"
CURRENCY=INR
APP_TIMEZONE=Asia/Kolkata
# Days before the due date that reminder #1 is sent
REMINDER_LEAD_DAYS=3
